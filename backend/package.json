{
  "name": "iter-scheduling-api",
  "version": "1.0.0",
  "description": "University Scheduling System — Express API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && mkdir -p dist/fixtures && cp src/fixtures/*.json dist/fixtures/",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "generate:mock-data": "tsx src/scripts/generate-large-schedule.ts",
    "lint": "tsc --noEmit",
    "benchmark": "tsx src/scripts/benchmark.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "cors": "^2.8.6",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "morgan": "^1.11.0",
    "neo4j-driver": "^6.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.8",
    "allure-vitest": "^3.2.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
